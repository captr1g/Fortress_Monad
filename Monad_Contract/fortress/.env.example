# Monad RPC endpoints (foundry.toml [rpc_endpoints])
# Verified live in Phase 0: chain IDs 143 and 10143 respectively.
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Contract verification (foundry.toml [etherscan]).
# Endpoint is recorded UNVERIFIED in RESEARCH.md §11 — confirm before Phase 9.
MONADSCAN_API_KEY=
MONAD_VERIFIER_URL=

# Deployer key. Use a throwaway TESTNET-ONLY key.
# Never reuse the Base deployer key, and never commit a real key.
PRIVATE_KEY=
