# ═══════════════════════════════════════════════════════════════
#  🏰 FORTRESS on Monad — Root Environment Configuration
#  Copy this file to .env at the project root to run with Docker Compose:
#    cp .env.example .env
#    docker compose up -d --build
# ═══════════════════════════════════════════════════════════════

# ── 1. Backend Service Configuration ──
PORT=3000
NODE_ENV=production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://fortress.bhattdev.in,http://fortress.bhattdev.in,https://api.fortress.bhattdev.in

# ── LLM Planner (OpenAI / OpenRouter) ──
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
OPENAI_MODEL=gpt-4o
# Optional OpenRouter proxy: https://openrouter.ai/api/v1
OPENAI_BASE_URL=
OPENAI_FALLBACK_MODELS=
OPENAI_FINAL_FALLBACK_API_KEY=
OPENAI_FINAL_FALLBACK_MODEL=

# ── Tenderly Simulation ──
TENDERLY_ACCESS_KEY=your_tenderly_access_key
TENDERLY_ACCOUNT_SLUG=your_account_slug
TENDERLY_PROJECT_SLUG=your_project_slug

# ── Backend RPC Endpoints ──
RPC_BASE=https://mainnet.base.org
RPC_ETH=https://ethereum-rpc.publicnode.com
RPC_ARB=https://arb1.arbitrum.io/rpc
RPC_MONAD=https://rpc.monad.xyz
RPC_MONAD_TESTNET=https://testnet-rpc.monad.xyz

# ── Database & Redis ──
# Local Docker Postgres/Redis (default) OR external Azure Postgres/Redis:
APY_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/fortress?sslmode=disable
# APY_DATABASE_URL=postgresql://monad_postgres:8WmWabetdC7nJ2en@monad.postgres.database.azure.com:5432/postgres?sslmode=require
APY_REDIS_URL=redis://redis:6379
APY_POLL_INTERVAL_MS=60000
APY_MAX_STALENESS_MS=300000
POSITIONS_POLL_INTERVAL_MS=30000
POSITIONS_CACHE_TTL_SECONDS=60
POSITIONS_STALE_MS=60000
POSITIONS_WALLET_TTL_DAYS=7

# ── Contracts (Base / Monad) ──
FORTRESS_CHAIN_ID=8453
FORTRESS_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
FORTRESS_LIFI_DIAMOND=0x1231DEB6f5749EF6cE6943a275A1D3E7486F4EaE
FORTRESS_MORPHO_BLUE=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb
AAVE_POOL_BASE=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5

FORTRESS_MONAD_CHAIN_ID=143
FORTRESS_MONAD_VAULT=
FORTRESS_MONAD_STRATEGY_EXECUTOR=
FORTRESS_MONAD_SWAP_ROUTER=
FORTRESS_MONAD_USDC=
FORTRESS_MONAD_WMON=
FORTRESS_MONAD_LIFI_DIAMOND=

# ── 2. Frontend Web Configuration ──
NEXT_PUBLIC_API_BASE=https://api.fortress.bhattdev.in
BACKEND_API_ORIGIN=http://backend:3000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=07ca18e4747adb59df06ff3f799b61ba
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_MONAD_USDC_ADDRESS=
NEXT_PUBLIC_MONAD_WMON_ADDRESS=
NEXT_PUBLIC_MONAD_WETH_ADDRESS=
