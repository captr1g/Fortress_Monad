# ═══════════════════════════════════════════════════════════════
#  FORTRESS Backend — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit real secrets here — this file is tracked in git.
# ═══════════════════════════════════════════════════════════════

# ── LLM Provider ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional: point at any OpenAI-compatible endpoint (e.g. OpenRouter)
OPENAI_BASE_URL=
# Optional: comma-separated fallback models (tried in order if primary fails)
OPENAI_FALLBACK_MODELS=
# Optional: final fallback provider (different key + model for last resort)
OPENAI_FINAL_FALLBACK_API_KEY=
OPENAI_FINAL_FALLBACK_MODEL=

# ── Rate Limiting ──
# Set to "true" to disable plan rate limit (dev/testing only — NEVER in production)
#DISABLE_PLAN_RATE_LIMIT=true

# ── Tenderly (simulation) ──
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=

# ── RPC Endpoints ──
# Monad mainnet (chain 143) is the only chain FORTRESS executes on. The public
# endpoint below is what ADDRESSES.md was verified against and serves archive
# state deep enough for the 7-day ERC-4626 APY sample; swap in a dedicated
# provider if you need higher rate limits.
RPC_MONAD=https://rpc.monad.xyz
# Only used when FORTRESS_CHAIN_ID is set to the testnet id (10143).
RPC_MONAD_TESTNET=https://testnet-rpc.monad.xyz

# ── Server ──
PORT=3000

# ── LiFi ──
LIFI_API_KEY=

# ── APY Service (Postgres + Redis) ──
APY_DATABASE_URL=postgresql://monad_postgres:8WmWabetdC7nJ2en@monad.postgres.database.azure.com:5432/postgres?sslmode=require
APY_REDIS_URL=redis://default:yFYIY0o26mU9Ft9A3uWgqfqHBu84635vtAZCAFUf_bs=@monad.southindia.redis.azure.net:10000
APY_POLL_INTERVAL_MS=60000
APY_MAX_STALENESS_MS=300000
POSITIONS_POLL_INTERVAL_MS=30000
POSITIONS_CACHE_TTL_SECONDS=60
POSITIONS_STALE_MS=60000
POSITIONS_WALLET_TTL_DAYS=7
AAVE_POOL_MONAD=0x69a5F9AD4f96ebf0a0C792dD42a01cC5C0102fef

# ── CORS (comma-separated origins, or * for dev) ──
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── FORTRESS Contracts (Monad mainnet, chain 143) ──
# All values below are the defaults compiled into src/chains/evm/config/monad.ts.
# Leave them unset to use those defaults; set them only to point at a different
# deployment. Source: Monad_Contract/Fortress/DEPLOYMENT.md and ADDRESSES.md.
FORTRESS_CHAIN_ID=143
FORTRESS_VAULT=0x252709C4569E096BD4babe3be9175Ca2F49f152F
FORTRESS_SWAP_ROUTER=0x220C82bF47cD376f9B71d038Ca45aC6E98482CC0
FORTRESS_CROSS_CHAIN_ROUTER=0x64b65CF8469bcdb81D8621Cbc4e2F2B36D4f39EE
FORTRESS_USDC=0x754704Bc059F8C67012fEd69BC8A327a5aafb603
FORTRESS_LIFI_DIAMOND=0x026F252016A7C47CDEf1F05a3Fc9E20C92a49C37
FORTRESS_MORPHO_BLUE=0xD5D960E8C380B724a48AC59E2DfF1b2CB4a1eAee
FORTRESS_PENDLE_ROUTER=0x888888888889758F76e7103c6CbF23ABbF58F946

# ── Not deployed on Monad yet ──
# These contracts exist in Monad_Contract/Fortress/src but are absent from the
# mainnet deployment, so they default to the zero address and boot.ts leaves the
# matching capabilities ("strategy", "leverage", "exit") unregistered — the
# planner refuses those requests instead of emitting calldata that would revert.
# Fill these in AND add the capabilities in boot.ts once they are deployed.
FORTRESS_STRATEGY_EXECUTOR=
FORTRESS_MORPHO_EXIT_EXECUTOR=
FORTRESS_MORPHO_LEVERAGE_EXECUTOR=
FORTRESS_MORPHO_ADAPTER=
FORTRESS_SWAP_ADAPTER=
FORTRESS_PENDLE_ADAPTER=

# ── Analytics ──
# No secret to configure — analytics starts automatically as long as
# APY_DATABASE_URL is reachable. app_user/user_event store lowercased wallet
# addresses directly (not hashed): tracked_wallets, user_positions and
# saved_strategies already hold raw addresses in this same database, so
# hashing only these two tables wouldn't have stopped anyone with DB access
# from reading them. Keep addresses out of dashboards via a read-only
# Postgres role scoped to the daily_funnel/user_cohorts views, not schema tricks.

# Comma-separated wallet addresses allowed to read /admin/metrics. Empty =
# the dashboard route is not registered at all (deny by default).
ADMIN_WALLETS=
