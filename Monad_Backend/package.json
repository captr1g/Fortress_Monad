{
  "name": "prompt-to-defi-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/boot.ts",
    "start": "node --import tsx src/boot.ts",
    "build": "npm run typecheck && npm run test && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "RUN_INTEGRATION=1 vitest run --config vitest.integration.config.ts",
    "test:report": "vitest run --config vitest.config.ts && echo '\\n--- INTEGRATION TIER ---\\n' && RUN_INTEGRATION=1 vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.11.1",
    "openai": "^4.77.0",
    "pg": "^8.22.0",
    "viem": "^2.21.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "fast-check": "^4.8.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}